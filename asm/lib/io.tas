IO_PUTC:
ST1( ZERO, P01, _NOP, n );
RET;

IO_PUTS:
ADDI( P03, P01, _NOP, 0 );
ADDI( P05, ZERO, _NOP, @(IO_PUTS_PRINT - IO_PUTS_CHECK - 10) );
IO_PUTS_LOOP:
LD1( P01, P03, _NOP, 0 );
IO_PUTS_CHECK:
ADS( PC, P05, _NOP, P05, _NOP );
BRANCH(IO_PUTS_DONE);
IO_PUTS_PRINT:
CALL(IO_PUTC);
ADDI( P03, P03, _NOP, 1 );
BRANCH(IO_PUTS_LOOP);
IO_PUTS_DONE:
ADDI( P01, P03, _NOP, 0 );
RET;

IO_GETC:
ADDI( P05, ZERO, _NOP, @(IO_GETC_READ - IO_GETC_CHECK - 10) );
ADDI( P06, ZERO, _NOP, @(IO_GETC_EOF - IO_GETC_CHECK - 10) );
IO_GETC_WAIT:
LD1( P02, ZERO, _NOP, n001 );
IO_GETC_CHECK:
ADS( PC, P05, _NOP, P06, _NOP );
BRANCH(IO_GETC_WAIT);
IO_GETC_READ:
LD1( P01, ZERO, _NOP, n );
RET;
IO_GETC_EOF:
ADDI( P01, ZERO, _NOP, 0 );
RET;

IO_READ_TRYTE:
ADDI( P08, ZERO, _NOP, 0 );
ADDI( P09, ZERO, _NOP, 100 );
IO_READ_TRYTE_WAIT:
CALL(IO_GETC);
ADDI( P10, P02, _NOP, 0 );
IO_READ_TRYTE_STATUS_CHECK:
ADSI( PC, @(IO_READ_TRYTE_GOT - IO_READ_TRYTE_STATUS_CHECK - 10), @(IO_READ_TRYTE_EOF - IO_READ_TRYTE_STATUS_CHECK - 10) );
IO_READ_TRYTE_GOT:
MULI( P08, P08, _NOP, 10 );
ADD( P08, P08, _NOP, P01, _NOP );
ADDI( P09, P09, _NOP, n );
ADDI( P10, P09, _NOP, 0 );
IO_READ_TRYTE_COUNT_CHECK:
ADSI( PC, @(IO_READ_TRYTE_WAIT - IO_READ_TRYTE_COUNT_CHECK - 10), @(IO_READ_TRYTE_DONE - IO_READ_TRYTE_COUNT_CHECK - 10) );
IO_READ_TRYTE_DONE:
ADDI( P01, P08, _NOP, 0 );
RET;
IO_READ_TRYTE_EOF:
ADDI( P01, ZERO, _NOP, 0 );
RET;
